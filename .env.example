# Copy this file to .env on the backend machine. Never put the service-role key in Android code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_SERVER_KEY

# Optional backend provider keys.
KINOPOISK_API_KEY=
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
